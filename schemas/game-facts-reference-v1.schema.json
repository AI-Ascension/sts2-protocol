{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-game-facts-reference-v1",
  "title": "STS2 game-facts-reference-v1 typed rule-input candidate",
  "description": "Closed inert contract; it carries producer evidence but does not evaluate game rules.",
  "oneOf": [
    { "$ref": "#/$defs/query_request" },
    { "$ref": "#/$defs/query_response" },
    { "$ref": "#/$defs/capabilities_response" },
    { "$ref": "#/$defs/error_response" }
  ],
  "$defs": {
    "identity": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "facts_identity": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+){0,7}$",
      "not": { "pattern": "^[Ff][Ii][Ll][Ee]" }
    },
    "reason": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "not": { "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]" }
    },
    "safe_integer": {
      "type": "integer", "minimum": 0, "maximum": 9007199254740991
    },
    "signed_safe_integer": {
      "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991
    },
    "entity_kind": {
      "enum": ["card", "character", "enemy", "event", "map_node", "potion", "power", "relic", "room", "status", "rest_option"]
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "artifact": { "const": "sts2-protocol/game-facts-reference-v1" },
        "source": { "const": "schemas/game-facts-reference-v1.schema.json" },
        "generator": { "const": "hand-authored" }
      },
      "required": ["artifact", "source", "generator"]
    },
    "instance_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "instance_id": { "$ref": "#/$defs/identity" },
        "run_id": { "$ref": "#/$defs/identity" },
        "epoch": { "$ref": "#/$defs/safe_integer" },
        "entity_kind": { "$ref": "#/$defs/entity_kind" },
        "entity_id": { "$ref": "#/$defs/identity" }
      },
      "required": ["instance_id", "run_id", "epoch", "entity_kind", "entity_id"]
    },
    "snapshot_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/identity" },
        "instance_ref": { "$ref": "#/$defs/instance_ref" },
        "state_generation": { "$ref": "#/$defs/safe_integer" }
      },
      "required": ["snapshot_id", "instance_ref", "state_generation"]
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "instance_id": { "$ref": "#/$defs/identity" },
        "run_id": { "$ref": "#/$defs/identity" },
        "authority_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "content_manifest_id": { "$ref": "#/$defs/identity" },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
      },
      "required": ["instance_id", "run_id", "authority_epoch", "content_manifest_id", "locale"]
    },
    "parent_observation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "instance_ref": { "$ref": "#/$defs/instance_ref" },
        "snapshot_ref": { "$ref": "#/$defs/snapshot_ref" },
        "state_generation": { "$ref": "#/$defs/safe_integer" }
      },
      "required": ["instance_ref", "snapshot_ref", "state_generation"]
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["static", "live"] },
        "content_manifest_id": { "$ref": "#/$defs/identity" },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
        "visibility_scope": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "instance_ref": { "anyOf": [{ "$ref": "#/$defs/instance_ref" }, { "type": "null" }] },
        "snapshot_ref": { "anyOf": [{ "$ref": "#/$defs/snapshot_ref" }, { "type": "null" }] }
      },
      "required": ["mode", "content_manifest_id", "locale", "visibility_scope", "instance_ref", "snapshot_ref"],
      "oneOf": [
        { "properties": { "mode": { "const": "static" }, "visibility_scope": { "type": "null" }, "instance_ref": { "type": "null" }, "snapshot_ref": { "type": "null" } } },
        { "properties": { "mode": { "const": "live" }, "visibility_scope": { "$ref": "#/$defs/identity" }, "instance_ref": { "$ref": "#/$defs/instance_ref" }, "snapshot_ref": { "$ref": "#/$defs/snapshot_ref" } } }
      ]
    },
    "query": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "rules_reference_version": { "const": 2 },
        "rule_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
        "binding": { "$ref": "#/$defs/binding" },
        "scope": { "anyOf": [{ "$ref": "#/$defs/scope" }, { "type": "null" }] },
        "parent_observation": { "anyOf": [{ "$ref": "#/$defs/parent_observation" }, { "type": "null" }] }
      },
      "required": ["rules_reference_version", "rule_ids", "binding", "scope", "parent_observation"],
      "oneOf": [
        { "properties": { "binding": { "properties": { "mode": { "const": "static" } } }, "scope": { "type": "null" }, "parent_observation": { "type": "null" } } },
        { "properties": { "binding": { "properties": { "mode": { "const": "live" } } }, "scope": { "$ref": "#/$defs/scope" }, "parent_observation": { "$ref": "#/$defs/parent_observation" } } }
      ]
    },
    "snapshot_policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "supports_live": { "const": true },
        "lifetime_generations": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_retained_snapshots": { "type": "integer", "minimum": 1, "maximum": 64 },
        "expiry_behavior": { "const": "reject_stale_snapshot" },
        "invalidated_by": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["restore", "restart", "profile_change", "content_change", "run_change", "epoch_change"] } }
      },
      "required": ["supports_live", "lifetime_generations", "max_retained_snapshots", "expiry_behavior", "invalidated_by"]
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "profile": { "const": "game-facts-reference-v1" },
        "rules_reference_version": { "const": 2 },
        "max_rule_ids": { "const": 16 },
        "max_inputs_per_rule": { "const": 64 },
        "max_unsupported_combinations": { "const": 256 },
        "max_message_bytes": { "const": 262144 },
        "snapshot_policy": { "anyOf": [{ "$ref": "#/$defs/snapshot_policy" }, { "type": "null" }] }
      },
      "required": ["profile", "rules_reference_version", "max_rule_ids", "max_inputs_per_rule", "max_unsupported_combinations", "max_message_bytes", "snapshot_policy"]
    },
    "unit": {
      "enum": ["damage", "hit_points", "block", "energy", "count", "turns", "rounds", "gold", "multiplier", "ratio", "entity", "boolean", "dimensionless"]
    },
    "typed_value": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "integer" }, "value": { "$ref": "#/$defs/signed_safe_integer" } }, "required": ["kind", "value"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "boolean" }, "value": { "type": "boolean" } }, "required": ["kind", "value"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "entity_ref" }, "entity_kind": { "$ref": "#/$defs/entity_kind" }, "id": { "$ref": "#/$defs/identity" } }, "required": ["kind", "entity_kind", "id"] }
      ]
    },
    "availability": { "enum": ["available", "unavailable", "not_observable", "redacted", "unsupported", "missing"] },
    "observation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/$defs/availability" },
        "value": { "anyOf": [{ "$ref": "#/$defs/typed_value" }, { "type": "null" }] },
        "reason": { "anyOf": [{ "$ref": "#/$defs/reason" }, { "type": "null" }] }
      },
      "required": ["availability", "value", "reason"],
      "oneOf": [
        { "properties": { "availability": { "const": "available" }, "value": { "$ref": "#/$defs/typed_value" }, "reason": { "type": "null" } } },
        { "properties": { "availability": { "enum": ["unavailable", "not_observable", "redacted", "unsupported", "missing"] }, "value": { "type": "null" }, "reason": { "$ref": "#/$defs/reason" } } }
      ]
    },
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["content_manifest", "game_mod", "gateway_projection", "synthetic"] },
        "ref": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+){0,7}$", "not": { "pattern": "^[Ff][Ii][Ll][Ee]" } }, { "type": "null" }] }
      },
      "required": ["kind", "ref"]
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/identity" },
        "unit": { "$ref": "#/$defs/unit" },
        "applicability": { "enum": ["required", "conditional", "unknown"] },
        "observation": { "anyOf": [{ "$ref": "#/$defs/observation" }, { "type": "null" }] },
        "source_ref": { "$ref": "#/$defs/source_ref" }
      },
      "required": ["name", "unit", "applicability", "observation", "source_ref"]
    },
    "result_entry": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "kind": { "const": "found" }, "rule_id": { "$ref": "#/$defs/identity" },
            "evidence_status": { "enum": ["confirmed", "source_derived", "proposed", "inferred", "unverified"] },
            "inputs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/input" } }
          },
          "required": ["kind", "rule_id", "evidence_status", "inputs"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": { "kind": { "const": "unsupported" }, "rule_id": { "$ref": "#/$defs/identity" }, "reason_code": { "enum": ["missing_capability", "unsupported_field"] } },
          "required": ["kind", "rule_id", "reason_code"]
        }
      ]
    },
    "inventory_manifest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "catalog_generation": { "$ref": "#/$defs/safe_integer" },
        "adapter_compatibility": { "$ref": "#/$defs/facts_identity" },
        "content_set_revision": { "$ref": "#/$defs/facts_identity" },
        "localized_text_revision": { "$ref": "#/$defs/facts_identity" },
        "inventory_revision": { "$ref": "#/$defs/facts_identity" }
      },
      "required": ["catalog_generation", "adapter_compatibility", "content_set_revision", "localized_text_revision", "inventory_revision"]
    },
    "inventory_binding": {
      "type": "object", "additionalProperties": false,
      "properties": { "build_id": { "$ref": "#/$defs/facts_identity" }, "mode_id": { "$ref": "#/$defs/facts_identity" }, "manifest": { "$ref": "#/$defs/inventory_manifest" } },
      "required": ["build_id", "mode_id", "manifest"]
    },
    "unsupported_combination": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "rule_ids": { "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "required": ["rule_ids", "reason"]
    },
    "query_result": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "producer_version": { "$ref": "#/$defs/identity" },
        "rules_reference_version": { "const": 2 },
        "inventory_binding": { "$ref": "#/$defs/inventory_binding" },
        "results": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/result_entry" } },
        "unsupported_combinations": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/unsupported_combination" } }
      },
      "required": ["producer_version", "rules_reference_version", "inventory_binding", "results", "unsupported_combinations"]
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "code": { "enum": ["unknown_kind", "unknown_id", "ambiguous_id", "unsupported_filter", "unsupported_projection", "unsupported_version", "denied_scope", "stale_snapshot", "stale_cursor", "result_limit_exceeded", "missing_capability", "unsupported_field", "invalid_identity", "invalid_bounds", "mixed_generation", "malformed", "read_only_violation", "invalid_request", "invalid_binding", "ambiguous_entity"] },
        "field": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "reason": { "anyOf": [{ "$ref": "#/$defs/reason" }, { "type": "null" }] },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "field", "reason", "retryable"]
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "protocol_version": { "const": "game-facts-reference-v1" },
        "schema_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "correlation_id": { "$ref": "#/$defs/identity" },
        "kind": { "enum": ["query_request", "query_response", "capabilities_response", "error_response"] },
        "query": { "anyOf": [{ "$ref": "#/$defs/query" }, { "type": "null" }] },
        "result": { "anyOf": [{ "$ref": "#/$defs/query_result" }, { "type": "null" }] },
        "capabilities": { "anyOf": [{ "$ref": "#/$defs/capabilities" }, { "type": "null" }] },
        "error": { "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] }
      },
      "required": ["protocol_version", "schema_digest", "provenance", "correlation_id", "kind", "query", "result", "capabilities", "error"]
    },
    "query_request": {
      "allOf": [{ "$ref": "#/$defs/envelope" }, { "properties": { "kind": { "const": "query_request" }, "query": { "$ref": "#/$defs/query" }, "result": { "type": "null" }, "capabilities": { "type": "null" }, "error": { "type": "null" } } }]
    },
    "query_response": {
      "allOf": [{ "$ref": "#/$defs/envelope" }, { "properties": { "kind": { "const": "query_response" }, "query": { "$ref": "#/$defs/query" }, "result": { "$ref": "#/$defs/query_result" }, "capabilities": { "type": "null" }, "error": { "type": "null" } } }]
    },
    "capabilities_response": {
      "allOf": [{ "$ref": "#/$defs/envelope" }, { "properties": { "kind": { "const": "capabilities_response" }, "query": { "type": "null" }, "result": { "type": "null" }, "capabilities": { "$ref": "#/$defs/capabilities" }, "error": { "type": "null" } } }]
    },
    "error_response": {
      "allOf": [{ "$ref": "#/$defs/envelope" }, { "properties": { "kind": { "const": "error_response" }, "result": { "type": "null" }, "capabilities": { "type": "null" }, "error": { "$ref": "#/$defs/error" } } }]
    }
  }
}
